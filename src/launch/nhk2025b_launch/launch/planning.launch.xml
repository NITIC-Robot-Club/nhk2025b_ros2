<launch>
  <node_container pkg="rclcpp_components" exec="component_container" name="nhk2025b_planning_control_container" namespace="">
    <composable_node pkg="nhk2025b_path_planner" plugin="path_planner::path_planner" name="path_planner">
      <param from="$(find-pkg-share nhk2025b_launch)/param/planning.yaml"/>
      <param from="$(find-pkg-share nhk2025b_launch)/param/global_settings.yaml"/>
    </composable_node>
    <composable_node pkg="nhk2025b_pure_pursuit" plugin="pure_pursuit::pure_pursuit" name="pure_pursuit">
      <param from="$(find-pkg-share nhk2025b_launch)/param/control.yaml"/>
    </composable_node>
    <composable_node pkg="nhk2025b_velocity_smoother" plugin="velocity_smoother::velocity_smoother" name="velocity_smoother">
      <param from="$(find-pkg-share nhk2025b_launch)/param/control.yaml"/>
      <param name="allow_automate_always" value="true"/>
    </composable_node>
  </node_container>
  <node pkg="nhk2025b_behavior" exec="behavior" name="behavior" output="screen">
    <param name="state_graph_path" value="$(find-pkg-share nhk2025b_launch)/state_graph/real.md"/>
  </node>
</launch>