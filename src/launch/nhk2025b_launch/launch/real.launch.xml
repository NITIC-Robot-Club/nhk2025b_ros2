<launch>
  <node_container pkg="rclcpp_components" exec="component_container" name="nhk2025b_container" namespace="">
    <composable_node pkg="nhk2025b_swerve_calculator" plugin="swerve_calculator::swerve_calculator" name="swerve_calculator"/>
    <composable_node pkg="nhk2025b_velocity_smoother" plugin="velocity_smoother::velocity_smoother" name="velocity_smoother">
      <param from="$(find-pkg-share nhk2025b_launch)/param/control.yaml"/>
      <param name="allow_automate_always" value="false"/>
    </composable_node>
    <composable_node pkg="nhk2025b_canable" plugin="canable::canable" name="canable"/>
  </node_container>
  <include file="$(find-pkg-share nhk2025b_launch)/launch/default.launch.xml"/>
  <include file="$(find-pkg-share nhk2025b_launch)/launch/sensor.launch.xml"/>
  <include file="$(find-pkg-share nhk2025b_launch)/launch/localization.launch.xml"/>
  <!-- <include file="$(find-pkg-share nhk2025b_launch)/launch/planning.launch.xml"/> -->
</launch>