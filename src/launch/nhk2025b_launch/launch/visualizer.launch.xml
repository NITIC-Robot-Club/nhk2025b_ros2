<launch>
    <arg name="rviz_config" default="simulation"/>
    <node_container pkg="rclcpp_components" exec="component_container" name="nhk2025b_visualization_container" namespace="">
        <composable_node pkg="nhk2025b_visualization" plugin="visualize_swerve::visualize_swerve" name="visualize_swerve"/>
        <composable_node pkg="nhk2025b_visualization" plugin="visualize_box::visualize_box" name="visualize_box"/>
        <composable_node pkg="nhk2025b_visualization" plugin="visualize_footprint::visualize_footprint" name="visualize_footprint">
            <param from="$(find-pkg-share nhk2025b_launch)/param/global_settings.yaml"/>
            <param from="$(find-pkg-share nhk2025b_launch)/param/visualization.yaml"/>
        </composable_node>
        <composable_node pkg="nhk2025b_visualization" plugin="visualize_path_collision::visualize_path_collision" name="visualize_path_collision">
            <param from="$(find-pkg-share nhk2025b_launch)/param/global_settings.yaml"/>
            <param from="$(find-pkg-share nhk2025b_launch)/param/visualization.yaml"/>
        </composable_node>
        <composable_node pkg="nhk2025b_visualization" plugin="visualize_stl::visualize_stl" name="visualize_field">
            <remap from="output/maker" to="/visualize/field"/>
            <param from="$(find-pkg-share nhk2025b_launch)/config/visualize_field.yaml"/>
            <param name="marker.meshpath" value="$(find-pkg-share nhk2025b_launch)/stl/field.stl"/>
        </composable_node>
        <composable_node pkg="nhk2025b_visualization" plugin="visualize_stl::visualize_stl" name="visualize_robot">
            <remap from="output/maker" to="/visualize/robot"/>
            <param from="$(find-pkg-share nhk2025b_launch)/config/visualize_robot.yaml"/>
            <param name="marker.meshpath" value="$(find-pkg-share nhk2025b_launch)/stl/robot.stl"/>
        </composable_node>
    </node_container>
    <node
        pkg="rviz2"
        exec="rviz2"
        args="-d $(find-pkg-share nhk2025b_launch)/rviz/$(var rviz_config).rviz"/>
</launch>