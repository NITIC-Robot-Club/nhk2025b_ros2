<launch>
  <node_container pkg="rclcpp_components" exec="component_container" name="nhk2025b_simulation_container" namespace="">
    <composable_node pkg="nhk2025b_simulation" plugin="simulation::simulation" name="simulation">
      <param from="$(find-pkg-share nhk2025b_launch)/param/global_settings.yaml"/>
    </composable_node>
    <composable_node pkg="nhk2025b_simulation" plugin="lidar_simulation::lidar_simulation" name="lidar_simulation_front">
      <param from="$(find-pkg-share nhk2025b_launch)/param/simulation.yaml"/>
      <remap from="/sensor/scan" to="/sensor/lidar/front/scan"/>
    </composable_node>
    <composable_node pkg="nhk2025b_simulation" plugin="lidar_simulation::lidar_simulation" name="lidar_simulation_rear">
      <param from="$(find-pkg-share nhk2025b_launch)/param/simulation.yaml"/>
      <remap from="/sensor/scan" to="/sensor/lidar/rear/scan"/>
    </composable_node>
    <composable_node pkg="nhk2025b_simulation" plugin="box_state_simulation::box_state_simulation" name="box_state_simulation"/>
    <composable_node pkg="nhk2025b_swerve_calculator" plugin="swerve_calculator::swerve_calculator" name="swerve_calculator">
      <param from="$(find-pkg-share nhk2025b_launch)/param/global_settings.yaml"/>
    </composable_node>
    <composable_node pkg="nhk2025b_simulation" plugin="arm_simulation::arm_simulation" name="arm_simulation"/>
  </node_container>
  <include file="$(find-pkg-share nhk2025b_launch)/launch/default.launch.xml"/>
  <include file="$(find-pkg-share nhk2025b_launch)/launch/localization.launch.xml"/>
  <include file="$(find-pkg-share nhk2025b_launch)/launch/planning.launch.xml"/>
  <include file="$(find-pkg-share nhk2025b_launch)/launch/visualizer.launch.xml">
    <arg name="rviz_config" value="arm_test"/>
  </include>
  <node pkg="nhk2025b_behavior" exec="behavior" name="behavior" output="screen">
    <param name="state_graph_path" value="$(find-pkg-share nhk2025b_launch)/state_graph/arm_test.md"/>
  </node>
  <include file="$(find-pkg-share nhk2025b_launch)/launch/urdf.launch.py"/>
</launch>